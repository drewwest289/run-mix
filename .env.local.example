# Copy this file to .env.local and fill in your own values.

# Spotify app: https://developer.spotify.com/dashboard -> Create app
# Add this exact redirect URI in the app's settings:
#   http://127.0.0.1:3000/api/auth/spotify/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/auth/spotify/callback

# Strava app: https://www.strava.com/settings/api
# Set "Authorization Callback Domain" to: 127.0.0.1
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://127.0.0.1:3000/api/auth/strava/callback

# Free API key from https://getsongbpm.com/api (used to look up song tempo,
# since Spotify no longer gives new apps access to its own tempo data)
GETSONGBPM_API_KEY=
